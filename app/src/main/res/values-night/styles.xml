<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorPrimary">@color/pk_primary</item>
        <item name="android:colorAccent">@color/pk_primary</item>
        <item name="android:colorControlActivated">@color/pk_primary</item>
        <item name="android:colorControlNormal">@color/pk_on_surface_variant</item>
        <item name="android:colorError">@color/pk_error</item>
        <item name="android:colorBackground">@color/pk_background</item>
        <item name="android:textColorPrimary">@color/pk_on_surface</item>
        <item name="android:textColorSecondary">@color/pk_on_surface_variant</item>
        <item name="android:textColorLink">@color/pk_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/pk_background</item>
        <item name="android:navigationBarColor">@color/pk_surface_container</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/pk_background</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>
    <style name="AppDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/pk_primary</item>
        <item name="android:colorControlActivated">@color/pk_primary</item>
        <item name="android:colorBackground">@color/pk_surface_container_high</item>
        <item name="android:textColorPrimary">@color/pk_on_surface</item>
        <item name="android:textColorSecondary">@color/pk_on_surface_variant</item>
        <item name="android:textColorAlertDialogListItem">@color/pk_on_surface</item>
        <item name="android:dialogCornerRadius">28dp</item>
    </style>
</resources>
